# Copie para .env (o .env nao vai para o git)
DATABASE_URL=postgres://wagering:wagering@127.0.0.1:15433/wagering

# LocalStack: endpoint local que fala o protocolo real da AWS
AWS_ENDPOINT_URL=http://127.0.0.1:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

SQS_QUEUE_NAME=wager-transactions.fifo
SQS_DLQ_NAME=wager-transactions-dlq.fifo

SQS_EVENTS_QUEUE_NAME=wager-events.fifo
DATABASE_SCHEMA=public

# API local; workers escolhem porta livre se METRICS_PORT não estiver definida.
PORT=3000
