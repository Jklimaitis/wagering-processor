{
  "name": "wagering-processor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/main.ts",
    "start:dev": "bun --watch src/main.ts",
    "test": "bun test src/domain test/unit test/integration",
    "check": "bun run typecheck && bun run test",
    "setup": "bun run db:up && bun run sqs:setup-wagers && bun run sqs:setup-events",
    "verify:compose": "bun test/e2e/compose-verification.ts",
    "typecheck": "tsc --noEmit",
    "db:check": "bun src/infrastructure/database/check-connection.ts",
    "db:up": "bun run --bun mikro-orm migration:up --config src/infrastructure/database/mikro-orm.config.ts",
    "db:list": "bun run --bun mikro-orm migration:list --config src/infrastructure/database/mikro-orm.config.ts",
    "sqs:setup-events": "bun src/scripts/setup-events-queue.ts",
    "worker:outbox": "bun src/workers/outbox-worker.ts",
    "sqs:setup-wagers": "bun src/scripts/setup-wager-queues.ts",
    "worker:wagers": "bun src/workers/wager-worker.ts",
    "worker:references": "bun src/workers/reference-worker.ts"
  },
  "devDependencies": {
    "@mikro-orm/cli": "7.2.0",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1159.0",
    "@mikro-orm/core": "7.2.0",
    "@mikro-orm/migrations": "7.2.0",
    "@mikro-orm/postgresql": "7.2.0",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "decimal.js": "^10.6.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  }
}
